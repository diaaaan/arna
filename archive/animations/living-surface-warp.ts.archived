// Variant B of the Living Surface: domain-warped noise lit like a dense,
// glossy liquid. The loop closes exactly because time only enters through
// orbits with integer harmonics (see orbit()).
export const WARP_LIQUID_SOURCE = `
uniform float2 resolution;
uniform float motionPhase;
uniform float3 backgroundColor;
uniform float3 deepNavy;
uniform float3 indigo;
uniform float3 cobalt;
uniform float3 violet;
uniform float3 cyan;
uniform float3 paleCyan;
uniform float3 lavenderWhite;
uniform float noiseScale;
uniform float warpStrength;
uniform float2 orbitRadius;
uniform float bumpStrength;
uniform float specularPower;

// Lattice-free smooth noise. Hash/floor/fract based value noise produced
// straight creases along lattice lines on the phone GPU, so the field is built
// from warped sines instead: continuous everywhere, no hashing, no cells.
float smoothNoise(float2 p) {
  float a = sin(p.x * 1.07 + sin(p.y * 0.83 + 1.7) * 1.1);
  float b = sin(p.y * 1.21 + sin(p.x * 0.91 + 0.3) * 1.3);
  float c = sin((p.x + p.y) * 0.73 + sin((p.x - p.y) * 0.57 + 2.1) * 0.9);
  return 0.5 + 0.2333 * (a + b + c);
}

float fbm(float2 p) {
  float sum = 0.0;
  float amp = 0.5;
  float2x2 rot = float2x2(0.8, -0.6, 0.6, 0.8);
  for (int i = 0; i < 3; i++) {
    sum += amp * smoothNoise(p);
    p = rot * p * 1.97 + float2(1.7, 0.9);
    amp *= 0.5;
  }
  return sum;
}

// Integer harmonics only: the loop closes exactly when motionPhase wraps.
float2 orbit(float angle, float harmonic) {
  return float2(cos(angle * harmonic), sin(angle * harmonic));
}

float field(float2 p, float a) {
  float2 q = p * noiseScale;
  float2 w1 = float2(
    fbm(q + orbitRadius.x * orbit(a, 1.0)),
    fbm(q + float2(5.2, 1.3) + orbitRadius.x * orbit(a + 2.1, 1.0))
  );
  float2 base = q + warpStrength * w1;
  float2 w2 = float2(
    fbm(base + float2(1.7, 9.2) + orbitRadius.y * orbit(0.7 - a, 2.0)),
    fbm(base + float2(8.3, 2.8) + orbitRadius.y * orbit(3.9 - a, 2.0))
  );
  return fbm(q + (warpStrength + 0.2) * w2);
}

half4 main(float2 position) {
  float2 uv = position / resolution;
  float aspect = resolution.x / resolution.y;
  float2 p = float2((uv.x - 0.5) * aspect, uv.y - 0.38);
  float a = motionPhase * 6.28318530718;

  float e = 0.005;
  float h = field(p, a);
  float hx = field(p + float2(e, 0.0), a);
  float hy = field(p + float2(0.0, e), a);
  float3 n = normalize(float3(
    -(hx - h) / e * bumpStrength,
    -(hy - h) / e * bumpStrength,
    1.0
  ));

  float3 light = normalize(float3(-0.45, -0.6, 0.65));
  float diffuse = clamp(dot(n, light) * 0.5 + 0.5, 0.0, 1.0);
  float spec = pow(
    clamp(dot(n, normalize(light + float3(0.0, 0.0, 1.0))), 0.0, 1.0),
    specularPower
  );
  float rim = pow(1.0 - clamp(n.z, 0.0, 1.0), 2.4);

  float3 col = mix(deepNavy, indigo, smoothstep(0.22, 0.52, h));
  col = mix(col, cobalt, smoothstep(0.42, 0.72, h) * 0.85);
  col = mix(col, violet, smoothstep(0.62, 0.9, h) * 0.35);
  col *= 0.5 + 0.95 * diffuse;
  col += paleCyan * spec * 0.55;
  col += cyan * rim * 0.22;
  col += lavenderWhite * rim * spec * 0.4;

  float activity = 1.0 - smoothstep(0.35, 1.0, uv.y);
  col = mix(backgroundColor, col, mix(0.2, 1.0, activity));
  return half4(clamp(col, 0.0, 1.0), 1.0);
}
`;
