export const LIVING_SURFACE_PRESET = 'livingFlowField' as const;

// The background is the "smear" shader (see living-surface-smear.ts). Older
// variants live in archive/animations. The palette can be switched at runtime
// by tapping the "Arna" title three times on the capture screen.
export type SmearModeName = 'base' | 'lava';
export const SMEAR_MODE_DEFAULT: SmearModeName = 'lava';
export const smearModes: Record<SmearModeName, { label: string; value: number }> = {
  base: { label: 'Сумерки', value: 0 },
  lava: { label: 'Лава', value: 1 },
};

export const smearPreset = {
