// Variant C of the Living Surface: a few heavy, glossy gel masses on a dark
// base. Masses drift on slow orbits and merge like thick oil (metaball field),
// lit with a soft diffuse, a wide satin highlight and a faint rim, plus fine
// grain. The loop closes exactly because time only enters through integer
// harmonics of motionPhase * 2π. No hashing or lattices in the shape itself.
export const GEL_SOURCE = `
uniform float2 resolution;
uniform float motionPhase;
uniform float3 backgroundColor;
uniform float3 c0;
uniform float3 c1;
uniform float3 c2;
uniform float3 c3;
uniform float3 c4;
uniform float3 c5;
uniform float3 highlight;
uniform float blobSize;
uniform float stretch;
uniform float bumpStrength;
uniform float grainAmount;

const float TAU = 6.28318530718;

// Centre of mass i at angle a: base position + integer-harmonic orbit.
float2 centre(int i, float a, float aspect) {
  float2 base; float2 rad; float k; float m; float ph;
  if (i == 0) { base = float2(-0.30, 0.22); rad = float2(0.20, 0.16); k = 1.0; m = 2.0; ph = 0.0; }
  else if (i == 1) { base = float2(0.30, 0.30); rad = float2(0.18, 0.20); k = 2.0; m = 1.0; ph = 1.3; }
  else if (i == 2) { base = float2(0.00, 0.50); rad = float2(0.26, 0.14); k = 1.0; m = 3.0; ph = 2.6; }
  else if (i == 3) { base = float2(-0.26, 0.64); rad = float2(0.16, 0.18); k = 3.0; m = 1.0; ph = 3.9; }
  else if (i == 4) { base = float2(0.28, 0.70); rad = float2(0.15, 0.15); k = 2.0; m = 2.0; ph = 5.1; }
  else { base = float2(0.02, 0.12); rad = float2(0.22, 0.12); k = 1.0; m = 1.0; ph = 0.7; }
  return float2(base.x * aspect * 1.6, base.y)
    + float2(rad.x * aspect * 1.6 * cos(a * k + ph), rad.y * sin(a * m + ph * 1.7));
}

half4 main(float2 position) {
  float2 uv = position / resolution;
  float aspect = resolution.x / resolution.y;
  float a = motionPhase * TAU;
  float2 p = float2((uv.x - 0.5) * aspect * 1.6, uv.y);

  // Slow, heavy shear of space: masses look pulled and stretched, not round.
  p += stretch * float2(
    0.10 * sin(p.y * 4.1 + a * 1.0) + 0.05 * sin(p.y * 7.3 - a * 2.0),
    0.08 * sin(p.x * 3.7 - a * 1.0) + 0.04 * sin(p.x * 6.1 + a * 3.0)
  );

  float f = 0.0;
  float2 grad = float2(0.0);
  float3 colSum = float3(0.0);
  for (int i = 0; i < 6; i++) {
    float2 d = p - centre(i, a, aspect);
    // Each mass slowly swells and shrinks (integer harmonic).
    float r = blobSize * (0.85 + 0.18 * sin(a * float(1 + i - (i / 3) * 3) + float(i) * 1.9));
    float w = exp(-dot(d, d) / (r * r));
    f += w;
    grad += w * (-2.0 * d / (r * r));
    float3 c = c0;
    if (i == 1) c = c1;
    else if (i == 2) c = c2;
    else if (i == 3) c = c3;
    else if (i == 4) c = c4;
    else if (i == 5) c = c5;
    colSum += w * c;
  }

  // Saturating thickness: masses merge into one dense body, edges stay soft.
  float k = 2.2;
  float e = exp(-f * k);
  float h = 1.0 - e;
  float2 gh = grad * (k * e);

  float3 n = normalize(float3(-gh * bumpStrength, 1.0));
  float3 light = normalize(float3(-0.45, -0.6, 0.65));
  float diffuse = clamp(dot(n, light) * 0.5 + 0.5, 0.0, 1.0);
  float3 halfV = normalize(light + float3(0.0, 0.0, 1.0));
  float ndh = clamp(dot(n, halfV), 0.0, 1.0);
  float satin = pow(ndh, 14.0) * 0.12;
  float gloss = pow(ndh, 70.0) * 0.22;
  float rim = pow(1.0 - clamp(n.z, 0.0, 1.0), 2.2);

  float3 body = colSum / max(f, 0.0001);
  // Thick middle glows from inside, thin edges fall off into the dark base.
  float core = smoothstep(0.25, 1.0, h);
  float3 col = mix(backgroundColor, body * (0.12 + 0.80 * diffuse * diffuse), smoothstep(0.12, 0.85, h));
  col += body * core * core * 0.10;
  col += highlight * (satin + gloss) * core;
  col += mix(body, highlight, 0.5) * rim * 0.14 * smoothstep(0.15, 0.6, h);

  float activity = 1.0 - smoothstep(0.55, 1.0, uv.y);
  col = mix(backgroundColor, col, mix(0.15, 1.0, activity));

  // Fine static grain.
  float g = fract(sin(dot(position, float2(12.9898, 78.233))) * 43758.5453);
  col += (g - 0.5) * grainAmount;

  return half4(clamp(col, 0.0, 1.0), 1.0);
}
`;
